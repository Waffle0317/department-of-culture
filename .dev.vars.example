# Local development secrets for `npm run preview` (wrangler dev).
# Copy to .dev.vars (gitignored). On Cloudflare, set the same two as Secrets
# under the Worker's Settings → Variables and Secrets.
#
# SESSION_SECRET: any long random string. Changing it signs everyone out.
# MEMBERS: JSON object of username → { hash, name, role }.
#          Make a hash with:  npm run hash -- "the password"
#
# The dev roll below has one member, "director", whose password is curator-1962

SESSION_SECRET=replace-with-a-long-random-string
MEMBERS={"director":{"hash":"pbkdf2$100000$6M03vyBXR6Rd0d9KwdPyMw$Sstw15CyMMFWiNitQlZmIQF2CuCKRlOv8H7W_ziVxaE","name":"Mateo Bucholtz","role":"Director"}}
