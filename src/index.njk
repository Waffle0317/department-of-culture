  <div class="section__inner reveal">
    <div class="section__head">
      <div class="section__kicker"><span class="label" style="color:var(--paper)">IV · Instruments</span></div>
      <h2 class="section__title">Proclamations <em>in force</em></h2>
    </div>
    <div class="procs">
      <ul class="proc-list">
        <li>
          <span class="date">10 Oct 1962</span>
          <a href="/proclamations/"><span class="what">Mandate on Culture<small>Establishes the Department as the instrument of the Advocate's investigative power under Home Rule Act s.6.</small></span></a>
          <span class="status">In force</span>
        </li>
        <li>
          <span class="date">14 Oct 1962</span>
          <a href="/proclamations/#dent"><span class="what">Determination regarding Richard Dent<small>The Department is charged with securing and examining the records of the District Attorney's office for Dent's tenure.</small></span></a>
          <span class="status">Determined</span>
        </li>
        <li>
