---
title: The Wire
section: Collection
app: true
---
<link rel="stylesheet" href="/assets/css/collection.css">
<div class="wire" id="wire">
  <aside class="wire__rooms">
    <div class="wire__roomshead"><span class="label label--red">Rooms</span></div>
    <nav class="wire__roomlist" id="roomList" aria-label="Rooms"></nav>
    <div class="wire__roomshead wire__roomshead--dm"><span class="label label--red">Private</span><button class="btn btn--ghost btn--sm" id="newDm" type="button">+ New</button></div>
    <nav class="wire__roomlist" id="dmList" aria-label="Private rooms"><p class="wire__none typewriter">No private rooms yet.</p></nav>
    <p class="wire__hint typewriter">Messages reach the room within a few seconds. Type @ to name a member or a file; the name opens their card. Nothing on the Wire leaves the Department.</p>
  </aside>
  <section class="wire__main">
    <header class="wire__head">
      <div>
        <div class="label label--red" id="roomKind">Room</div>
        <h1 class="wire__title" id="roomName">—</h1>
        <div class="wire__with typewriter" id="roomWith" hidden></div>
      </div>
      <button class="btn btn--ghost btn--sm" id="older" type="button" hidden>Earlier messages</button>
    </header>
    <div class="wire__log" id="log"><p class="muted">Opening the Wire…</p></div>
    <form class="wire__compose" id="compose">
      <div class="wire__composebox">
        <div class="wire__mentions" id="mentions" hidden></div>
        <textarea id="body" rows="2" maxlength="2000" placeholder="Write to the room… (@ to name someone)" required></textarea>
      </div>
      <button class="btn btn--red" type="submit" id="send">Send</button>
    </form>
    <div class="wire__closed typewriter" id="closed" hidden>Only the Office posts in Announcements.</div>
  </section>
  <div class="adm__toast" id="toast" hidden></div>

  <dialog class="col__dialog col__dialog--narrow" id="dmDialog">
    <form method="dialog" class="pf" id="dmForm">
      <header class="pf__head">
        <div class="label label--red">Private room</div>
        <h2 class="pf__title">Write to a member</h2>
      </header>
      <div class="pf__grid" style="grid-template-columns:1fr">
        <label class="field"><span>Who</span><input type="search" id="dmSearch" placeholder="Search the roll by name…" autocomplete="off"></label>
        <div class="wire__members" id="dmMembers"></div>
      </div>
      <footer class="pf__foot"><button type="button" class="btn btn--ghost" id="dmCancel">Cancel</button></footer>
    </form>
  </dialog>
</div>
<script src="/assets/js/chat.js" defer></script>
