      <div class="proc-doc__masthead">
        <div class="big">Public Advocate</div>
        <div class="of">of the</div>
        <div class="big" style="font-size:clamp(1.6rem,4vw,2.6rem)">Imperial Ruling Party</div>
        <div class="who">{{ site.city }} &nbsp;|&nbsp; {{ site.advocate }}</div>
        <div class="proc-doc__banner">Proclamation</div>
