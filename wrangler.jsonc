{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "department-of-culture",
  "main": "worker/index.js",
  "compatibility_date": "2025-10-01",
  // Keep variables and secrets set in the dashboard across deploys.
  "keep_vars": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // The Worker must see these before static assets are served,
    // so the personnel gate and the API run on every request.
    "run_worker_first": ["/api/*", "/department", "/department/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "department-of-culture",
      "database_id": "265dbf69-ed82-47e6-934e-82c2a983e347"
    }
  ],
  "observability": { "enabled": true }
}
